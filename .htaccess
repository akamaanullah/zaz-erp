# Keep application code, configuration, and storage off the web.
# The static prototype remains available for reference.
RewriteEngine On
RewriteRule ^(app|config|database|storage|tests|prototype)(/|$) - [F,L]
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^public/ - [L]
RewriteRule ^(.*)$ public/$1 [L]
