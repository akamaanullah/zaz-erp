# Copy values into the server environment or config/config.local.php.
# Do not commit real passwords, tokens, or ZAZ_APP_KEY values.
ZAZ_APP_ENV=local
ZAZ_DB_HOST=127.0.0.1
ZAZ_DB_PORT=3306
ZAZ_DB_NAME=zaz_agriculture
ZAZ_DB_USER=
ZAZ_DB_PASS=
ZAZ_ALLOW_DEMO_RESET=1
